# Generates shell code that records when the build ran.
genrule(
    name = "build_info",
    srcs = ["VERSION"],
    outs = ["build_info.sh"],
    cmd = ("{ echo \"BUILD_VERSION=$$(cat $(location VERSION))\"; " +
           "echo \"BUILD_TIMESTAMP=$$(date +%s)\"; } > $@"),
    # Executes the action on every build instead of reusing a cached result.
    tags = ["no-cache"],
)

# Bundles the generated build info and the application code into a single script.
genrule(
    name = "app",
    srcs = [
        ":build_info",
        "src/main.sh",
    ],
    outs = ["app.sh"],
    cmd = "{ echo '#!/usr/bin/env bash'; cat $(location :build_info) $(location src/main.sh); } > $@",
    executable = True,
)
